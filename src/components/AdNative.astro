---
// Adsterra Native Banner. ADSTERRA_NATIVE_KEY accepts a zone key or script URL.
// ADSTERRA_NATIVE_SRC can override the script URL.
// The label stays hidden until the network fills the container.
//
// On guide and news pages the slot sits right after the article text, before the
// series and related links.
import { ADS } from '../config/site.mjs';

interface Props {
  label: string;
}
const raw = ADS.nativeBanner.trim();
const isUrl = /^(https?:)?\/\//i.test(raw);
const key = isUrl ? (raw.match(/[a-f0-9]{32}/i)?.[0] ?? '') : raw;
const src = ADS.nativeBannerSrc.trim() || (isUrl ? raw : key ? `https://bauval.org/21/${key}` : '');
---

{
  key && src && (
    <aside class="ad-slot ad-native" aria-label={Astro.props.label}>
      <p class="ad-label">{Astro.props.label}</p>
      <script is:inline async="async" data-cfasync="false" src={src} />
      <div id={`container-${key}`} />
    </aside>
  )
}
