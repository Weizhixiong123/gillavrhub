---
// Adsterra Native Banner, placed in the middle of an article. Renders nothing unless
// ADS.nativeBanner is set. The label stays hidden until the network fills the container.
//
// Astro renders a guide's Markdown as one block, so the slot is rendered right after the
// article and a small script moves it in front of the article's middle h2 while the page
// is still loading. Articles with fewer than two h2s keep it after the text. The network
// finds the container by its id, so moving it doesn't affect loading.
import { ADS } from '../config/site.mjs';

interface Props {
  label: string;
}
const key = ADS.nativeBanner;
---

{
  key && (
    <aside class="ad-slot ad-native" aria-label={Astro.props.label}>
      <p class="ad-label">{Astro.props.label}</p>
      <script is:inline async="async" data-cfasync="false" src={`https://bauval.org/21/${key}`} />
      <div id={`container-${key}`} />
    </aside>
  )
}
{
  key && (
    <script is:inline>
      (() => {
        const slot = document.currentScript.previousElementSibling;
        const article = slot?.previousElementSibling;
        if (!slot || !article?.classList.contains('prose')) return;
        const headings = article.querySelectorAll(':scope > h2');
        if (headings.length < 2) return;
        article.insertBefore(slot, headings[Math.floor(headings.length / 2)]);
      })();
    </script>
  )
}
