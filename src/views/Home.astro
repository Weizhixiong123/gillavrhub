---
import BaseLayout, { type Alternate } from '../layouts/BaseLayout.astro';
import { getPublished, entryUrl } from '../lib/content';
import { GUIDE_CATEGORIES, OFFICIAL_LINKS } from '../config/site.mjs';
import { localize, plural, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Alternate[];
}
const { lang, alternates } = Astro.props;
const ui = t(lang);
// Store facts read from the Meta Quest listing (via vrdb.app) on 2026-11-19.
// Update them together with the "checked" date when the listing changes.
const FACTS: { label: string; value: string; href?: string }[] = [
  { label: 'Price', value: 'Free, with in-app purchases' },
  { label: 'Released', value: 'November 10, 2026 (Early Access)' },
  { label: 'Headsets', value: 'Quest 2, Quest 3, Quest 3S, Quest Pro' },
  { label: 'Play area', value: 'Standing or roomscale' },
  { label: 'Comfort', value: 'Intense' },
  { label: 'Age rating', value: 'Mature 17+' },
  { label: 'Developer', value: 'Play Gilla', href: OFFICIAL_LINKS.site },
];
const gameSchema = {
  '@type': 'VideoGame',
  name: 'GILLA',
  url: OFFICIAL_LINKS.site,
  sameAs: [OFFICIAL_LINKS.store],
  gamePlatform: 'Meta Quest',
  genre: ['Horror', 'Multiplayer'],
  author: { '@type': 'Organization', name: 'Play Gilla' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const guides = await getPublished('guides', lang);
const route = guides
  .filter((e) => e.data.series === 'first-night')
  .sort((a, b) => (a.data.step ?? 0) - (b.data.step ?? 0));
const monsters = Object.entries(ui.home.monsterNotes).flatMap(
  ([slug, monster]) => {
    const entry = guides.find((guide) => guide.id === `${lang}/the-${slug}`);
    return entry ? [{ ...monster, href: entryUrl('guides', entry.id) }] : [];
  },
);
// Only categories with published guides become folders; empty ones would be dead ends.
const folders = GUIDE_CATEGORIES.map((key) => ({
  key,
  ...ui.categories[key as keyof typeof ui.categories],
  count: guides.filter((e) => e.data.category === key).length,
})).filter((f) => f.count > 0);
const answers = (await getPublished('faq', lang))
  .filter((e) => !e.data.tags.includes('troubleshooting'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, lang))
  .slice(0, 8);
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  home
  schema={[gameSchema]}
  title={ui.home.metaTitle}
  description={ui.home.metaDescription}
>
  <section class="dispatch" aria-labelledby="home-title">
    <div class="dispatch-copy">
      <h1 id="home-title">{ui.home.title}</h1>
      <p class="lead">{ui.home.lead}</p>
      <form
        action={localize(lang, '/search/')}
        class="search-form"
        role="search"
      >
        <label class="sr-only" for="home-query">
          {ui.nav.searchLabel}
        </label>
        <input
          id="home-query"
          type="search"
          name="q"
          placeholder={ui.home.placeholder}
          required
        />
        <button type="submit">{ui.search.button}</button>
      </form>
      <p class="suggest">
        {ui.home.popular}
        {ui.home.popularTerms.map((term) => (
          <a
            href={`${localize(lang, '/search/')}?q=${encodeURIComponent(term)}`}
          >
            {term}
          </a>
        ))}
      </p>
      <div class="actions">
        <a class="button" href={localize(lang, '/guides/the-base-map/')}>
          {ui.home.openMap}
        </a>
        <a href={localize(lang, '/guides/beginner-guide/')}>{ui.home.newHere}</a>
      </div>
    </div>
    <figure class="wall">
      <svg viewBox="0 0 600 420" role="group" aria-labelledby="wall-title">
        <title id="wall-title">{ui.home.wallTitle}</title>
        <defs>
          <pattern id="hazard" width="22" height="22" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="11" height="22" class="fill-keycard" />
            <rect x="11" width="11" height="22" class="fill-ink" />
          </pattern>
          <marker id="tip" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M1 1 8 5 1 9" class="marker-line" />
          </marker>
        </defs>
        <!-- the room: lit wall, ceiling tube, floor -->
        <rect width="600" height="420" class="fill-wall" />
        <rect x="210" y="18" width="180" height="8" rx="4" class="tube" />
        <path d="M0 332H600V420H0Z" class="fill-floor" />
        <path d="M0 332H600" class="edge" />

        <a href={localize(lang, '/guides/the-grinner/')} aria-label={ui.home.wallNotes.grinner}>
          <text x="36" y="74" class="note note-warn" transform="rotate(-3 36 74)">{ui.home.wallNotes.grinner}</text>
          <path d="M38 86c60-6 150-9 232-12" class="scrawl scrawl-warn" />
        </a>

        <a href={localize(lang, '/guides/keycard-and-locked-door/')} aria-label={`1: ${ui.home.wallNotes.keycard}`}>
          <path d="M44 252h156v14H44Z" class="fill-steel edge" />
          <path d="M56 266v66M188 266v66" class="edge leg" />
          <path d="M96 250l8-13h46l-8 13Z" class="fill-keycard edge" />
          <path d="M101 243h44" class="stripe" />
          <path d="M80 246c4-22 76-26 88-6 8 16-30 24-58 21-22-2-34-8-28-19" class="scrawl" />
          <circle cx="54" cy="150" r="17" class="scrawl" />
          <text x="54" y="157" class="note step-no">1</text>
          <text x="80" y="158" class="note">{ui.home.wallNotes.keycard}</text>
        </a>
        <path d="M172 232c34-30 66-34 92-30" class="scrawl dash" marker-end="url(#tip)" />

        <a href={localize(lang, '/guides/keycard-and-locked-door/')} aria-label={`2: ${ui.home.wallNotes.reader}`}>
          <rect x="272" y="168" width="40" height="64" rx="4" class="fill-ink" />
          <rect x="280" y="179" width="24" height="7" rx="1" class="fill-led" />
          <rect x="280" y="200" width="24" height="4" class="fill-slot" />
          <circle cx="252" cy="116" r="17" class="scrawl" />
          <text x="252" y="123" class="note step-no">2</text>
          <text x="276" y="124" class="note">{ui.home.wallNotes.reader}</text>
        </a>
        <path d="M318 206c24-4 44-2 64 4" class="scrawl dash" marker-end="url(#tip)" />

        <a href={localize(lang, '/guides/keycard-and-locked-door/')} aria-label={`3: ${ui.home.wallNotes.door}`}>
          <rect x="392" y="140" width="150" height="192" class="fill-door edge" />
          <path d="M404 152h126v100H404Z" class="edge thin" />
          <rect x="392" y="262" width="150" height="26" fill="url(#hazard)" class="edge" />
          <circle cx="436" cy="104" r="17" class="scrawl" />
          <text x="436" y="111" class="note step-no">3</text>
          <text x="460" y="112" class="note">{ui.home.wallNotes.door}</text>
        </a>

        <a href={localize(lang, '/guides/the-mannequin/')} aria-label={`4: ${ui.home.wallNotes.down}. ${ui.home.wallNotes.mannequin}`}>
          <path d="M478 352h86l-12 30h-86Z" class="fill-ink" />
          <path d="M546 300c30 18 28 38 10 52" class="scrawl dash" marker-end="url(#tip)" />
          <circle cx="132" cy="372" r="17" class="scrawl" />
          <text x="132" y="379" class="note step-no">4</text>
          <text x="158" y="380" class="note">{ui.home.wallNotes.down}</text>
          <text x="584" y="408" class="note note-warn end">{ui.home.wallNotes.mannequin}</text>
        </a>
      </svg>
    </figure>
  </section>

  {monsters.length > 0 && (
    <section aria-labelledby="monsters-title">
      <div class="section-heading">
        <h2 id="monsters-title">{ui.home.monsters}</h2>
        <a href={localize(lang, '/guides/monsters/')}>{ui.home.allMonsters}</a>
      </div>
      <ul class="monster-list" role="list">
        {monsters.map((monster) => (
          <li>
            <a href={monster.href}>{monster.name}</a>
            <span class="monster-location">{monster.location}</span>
            <span class="monster-note">{monster.note}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="case-files" aria-labelledby="files-title">
    <div class="section-heading">
      <h2 id="files-title">{ui.home.topics}</h2>
      <a href={localize(lang, '/guides/')}>
        {plural(lang, guides.length, ui.home.allGuides)}
      </a>
    </div>
    <nav aria-label={ui.home.topics}>
      <ul class="topic-list" role="list">
        {folders.map((f) => (
          <li>
            <a href={localize(lang, `/guides/${f.key}/`)}>
              <span class="topic-name">{f.label}</span>
              <span class="topic-count">
                {plural(lang, f.count, ui.home.guideCount)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <div class="home-grid">
    <section aria-labelledby="route-title">
      <div class="section-heading">
        <h2 id="route-title">{ui.home.route}</h2>
      </div>
      <ol class="route-list">
        {route.map((e) => (
          <li>
            <a href={entryUrl('guides', e.id)}>
              <span>
                {e.data.title}
                <small>{e.data.description}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
    <section aria-labelledby="answers-title">
      <div class="section-heading">
        <h2 id="answers-title">{ui.home.answers}</h2>
        <a href={localize(lang, '/faq/')}>{ui.home.allAnswers}</a>
      </div>
      <ul class="answers">
        {answers.map((e) => (
          <li>
            <a href={entryUrl('faq', e.id)}>{e.data.title}</a>
            <p>{e.data.answer}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <aside class="facts" aria-labelledby="facts-title">
    <h2 id="facts-title">{ui.home.facts}</h2>
    <dl>
      {FACTS.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>
            {f.href ? (
              <a href={f.href} rel="noopener noreferrer">
                {f.value}
              </a>
            ) : (
              f.value
            )}
          </dd>
        </div>
      ))}
    </dl>
    <p class="facts-note">
      <a href={OFFICIAL_LINKS.store} rel="noopener noreferrer">
        Meta Quest store page
      </a>
      <a href={OFFICIAL_LINKS.discord} rel="noopener noreferrer">
        Official Discord
      </a>
    </p>
  </aside>
</BaseLayout>
