---
import BaseLayout, { type Alternate } from '../layouts/BaseLayout.astro';
import { getPublished, entryUrl, faqUrl, categoryHref, slugOf } from '../lib/content';
import ModeFinder from '../components/ModeFinder.astro';
import AdNative from '../components/AdNative.astro';
import { GUIDE_CATEGORIES, OFFICIAL_LINKS } from '../config/site.mjs';
import { localize, plural, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';
import { Image } from 'astro:assets';
import { screen } from '../lib/imagery';

interface Props {
  lang: Lang;
  alternates: Alternate[];
}
const { lang, alternates } = Astro.props;
const ui = t(lang);
// Store facts live in ui.home.factList (one copy per language); the developer links out.
const FACTS: { label: string; value: string; href?: string }[] = ui.home.factList.map(
  (f, i, all) => (i === all.length - 1 ? { ...f, href: OFFICIAL_LINKS.site } : f),
);
const gameSchema = {
  '@type': 'VideoGame',
  name: 'GILLA',
  url: OFFICIAL_LINKS.site,
  sameAs: [OFFICIAL_LINKS.store],
  gamePlatform: 'Meta Quest',
  genre: ['Horror', 'Multiplayer'],
  author: { '@type': 'Organization', name: 'Play Gilla' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const guides = await getPublished('guides', lang);
const route = guides
  .filter((e) => e.data.series === 'first-night')
  .sort((a, b) => (a.data.step ?? 0) - (b.data.step ?? 0));
// Only categories with published guides become folders; empty ones would be dead ends.
const folders = GUIDE_CATEGORIES.map((key) => ({
  key,
  ...ui.categories[key as keyof typeof ui.categories],
  count: guides.filter((e) => e.data.category === key).length,
}))
  .filter((f) => f.count > 0)
  .map((f) => ({ ...f, href: categoryHref(lang, f.key, guides) }));
// Order home quick answers by search demand (price, Discord, PC/Steam, headsets, release date, mods, friends, age).
const TOP_FAQ_ORDER = [
  'is-it-free',
  'discord',
  'pc-vr-steam',
  'supported-headsets',
  'release-date',
  'cheats-and-mods',
  'play-with-friends',
  'age-rating',
];
const answers = (await getPublished('faq', lang))
  .sort((a, b) => {
    const ia = TOP_FAQ_ORDER.indexOf(slugOf(a.id));
    const ib = TOP_FAQ_ORDER.indexOf(slugOf(b.id));
    if (ia !== -1 || ib !== -1) {
      return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
    }
    return a.data.title.localeCompare(b.data.title, lang);
  })
  .slice(0, 8);
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  home
  schema={[gameSchema]}
  title={ui.home.metaTitle}
  description={ui.home.metaDescription}
>
  <section class="dispatch" aria-labelledby="home-title">
    <div class="dispatch-copy">
      <h1 id="home-title">{ui.home.title}</h1>
      <p class="lead">{ui.home.lead}</p>
      <form
        action={localize(lang, '/search/')}
        class="search-form"
        role="search"
      >
        <label class="sr-only" for="home-query">
          {ui.nav.searchLabel}
        </label>
        <input
          id="home-query"
          type="search"
          name="q"
          placeholder={ui.home.placeholder}
          required
        />
        <button type="submit">{ui.search.button}</button>
      </form>
      <p class="suggest">
        {ui.home.popular}
        {ui.home.popularTerms.map((term) => (
          <a
            href={`${localize(lang, '/search/')}?q=${encodeURIComponent(term)}`}
          >
            {term}
          </a>
        ))}
      </p>
      <div class="actions">
        <a class="button" href={localize(lang, '/guides/the-base-map/')}>
          {ui.home.openMap}
        </a>
        <a href={localize(lang, '/guides/beginner-guide/')}>{ui.home.newHere}</a>
      </div>
    </div>
    <figure class="hero-shot">
      <Image
        src={screen('the-base-map')}
        alt={ui.home.heroAlt}
        widths={[480, 800, 1280]}
        sizes="(max-width: 760px) calc(100vw - 32px), 640px"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        {ui.home.heroCaption}.{' '}
        <a href={`${localize(lang, '/about/')}#game-imagery`}>{ui.home.credit}</a>
      </figcaption>
    </figure>
  </section>

  <section class="shots" aria-labelledby="shots-title">
    <h2 id="shots-title" class="sr-only">{ui.home.shotsTitle}</h2>
    <ol class="shot-steps">
      {ui.home.shots.map((shot) => (
        <li>
          <a href={localize(lang, shot.href)}>
            <Image
              src={screen(shot.image)}
              alt={shot.alt}
              widths={[360, 560]}
              sizes="(max-width: 760px) calc(100vw - 32px), 380px"
              loading="lazy"
            />
            <span class="shot-note">{shot.note}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <ModeFinder lang={lang} />

  <AdNative label={ui.adLabel} />

  <section class="case-files" aria-labelledby="files-title">
    <div class="section-heading">
      <h2 id="files-title">{ui.home.topics}</h2>
      <a href={localize(lang, '/guides/')}>
        {plural(lang, guides.length, ui.home.allGuides)}
      </a>
    </div>
    <nav aria-label={ui.home.topics}>
      <ul class="topic-list" role="list">
        {folders.map((f) => (
          <li>
            <a href={f.href}>
              <span class="topic-name">{f.label}</span>
              <span class="topic-count">
                {plural(lang, f.count, ui.home.guideCount)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <div class="home-grid">
    <section aria-labelledby="route-title">
      <div class="section-heading">
        <h2 id="route-title">{ui.home.route}</h2>
      </div>
      <ol class="route-list">
        {route.map((e) => (
          <li>
            <a href={entryUrl('guides', e.id)}>
              <span>
                {e.data.title}
                <small>{e.data.description}</small>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
    <section aria-labelledby="answers-title">
      <div class="section-heading">
        <h2 id="answers-title">{ui.home.answers}</h2>
        <a href={localize(lang, '/faq/')}>{ui.home.allAnswers}</a>
      </div>
      <ul class="answers">
        {answers.map((e) => (
          <li>
            <a href={faqUrl(e.id)}>{e.data.title}</a>
            <p>{e.data.answer}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <aside class="facts" aria-labelledby="facts-title">
    <h2 id="facts-title">{ui.home.facts}</h2>
    <dl>
      {FACTS.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>
            {f.href ? (
              <a href={f.href} rel="noopener noreferrer">
                {f.value}
              </a>
            ) : (
              f.value
            )}
          </dd>
        </div>
      ))}
    </dl>
    <p class="facts-note">
      <a href={OFFICIAL_LINKS.store} rel="noopener noreferrer">{ui.home.storeLink}</a>
      <a href={OFFICIAL_LINKS.discord} rel="noopener noreferrer">{ui.home.discordLink}</a>
    </p>
  </aside>
</BaseLayout>
