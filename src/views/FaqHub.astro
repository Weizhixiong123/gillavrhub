---
import BaseLayout, { type Alternate } from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getPublished, entryUrl, faqGroup } from '../lib/content';
import { localize, type Lang } from '../i18n/locales';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Alternate[];
}
const { lang, alternates } = Astro.props;
const ui = t(lang);
const entries = await getPublished('faq', lang);
const groups = (['general', 'troubleshooting'] as const)
  .map((key) => ({
    key,
    label: ui.hubs.faqGroups[key],
    items: entries
      .filter((e) => faqGroup(e) === key)
      .sort((a, b) => a.data.title.localeCompare(b.data.title, lang)),
  }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout
  lang={lang}
  alternates={alternates}
  title={ui.hubs.faq.title}
  description={ui.hubs.faq.description}
>
  <Breadcrumbs items={[{ label: ui.sections.home, href: localize(lang, '/') }, { label: ui.sections.faq }]} />
  <h1>{ui.hubs.faq.title}</h1>
  <p class="lead">{ui.hubs.faq.description}</p>
  <nav class="filters" aria-label={ui.sections.faq}>
    {groups.map((g) => <a href={`#${g.key}`}>{g.label}</a>)}
  </nav>
  {
    groups.map((g) => (
      <section class="hub-group" id={g.key}>
        <h2>{g.label}</h2>
        <ul class="answers">
          {g.items.map((e) => (
            <li>
              <a href={entryUrl('faq', e.id)}>{e.data.title}</a>
              <p>{e.data.answer}</p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
